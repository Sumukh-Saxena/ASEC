# Configuration overrides for the bucket parameters (seconds, positive integers).
# Unset or blank values fall back to the SRS §3.2 production defaults
# W=15, G=5, M=30, C=2. Invalid values fail loudly (BucketParamsError).
#BUCKET_WINDOW_W_S=
#BUCKET_BURST_GAP_G_S=
#BUCKET_MAX_DURATION_M_S=
#BUCKET_CLOSE_GRACE_C_S=

# ASEC environment template.
# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO
# Example secret key. Leave empty here; set the real value only in your local `.env`.
API_TOKEN=

# The single documented production database path. `discord-smoke` and
# `run-live` refuse a --db argument that resolves to this file; `run-live`
# without --db uses it. Leave unset in the template.
#ASEC_DB_PATH=
